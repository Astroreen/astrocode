{
  "$schema": "https://opencode.ai/config.json",
  // astrocode owns its own agents, commands, and fallback config — see
  // .opencode/astrocode.jsonc. Only the plugin entry belongs here.
  //
  // Relative plugin paths (./ or ../) resolve against THIS config file's
  // directory, so `../src/index.ts` points at the repo's own entry point on any
  // host — no hardcoded /home/<user>/... path.
  "plugin": ["../src/index.ts"]
}
