{
  // astrocode's OWN config file (the plugin reads this itself — see
  // src/config/astrocode.ts). Nothing astrocode-specific needs to go in
  // .opencode/opencode.jsonc anymore.
  //
  // Agent keys may be either opencode display names (what you see in the TAB
  // switcher, e.g. "Sisyphus - ultraworker") or canonical keys ("sisyphus").
  //
  // ── Model policy (2026-09) ──────────────────────────────────────────────
  // BASE models: anthropic only, served through the local meridian proxy.
  //
  // WARNING about discovery: the proxy's GET /v1/models list is INCOMPLETE and
  // POST /v1/messages does NOT validate model ids — a bogus id like
  // "claude-bogus-9-9" still answers 200. So the endpoint cannot be used to
  // probe availability. Ids below are the ones confirmed in actual use.
  //   anthropic/claude-opus-5-5              — current frontier, top reasoning
  //   anthropic/claude-sonnet-5              — balanced workhorse
  //   anthropic/claude-haiku-4-5-20251001    — cheap/fast, mechanical work
  //
  // Anthropic degradation step: opus burns its Pro cap well before sonnet does,
  // so opus-tier agents fall to sonnet-5 → haiku FIRST, and only then leave the
  // subscription for paid openrouter. Delete those two lines if you'd rather
  // jump straight to openrouter.
  //
  // ── How the openrouter chains were chosen ───────────────────────────────
  // EVERY openrouter entry is annotated `AA=<n> in/out ctx`, where AA is the
  // Artificial Analysis Intelligence Index v4.3.2 (composite of Terminal-Bench
  // 4.0, SciCode, HLE, GDPval-AA, AA-Briefcase, AutomationBench, AA-LCR,
  // AA-Omniscience, GDP.pdf, CritPt). Verified per-model on
  // artificialanalysis.ai/models/<slug> on 2026-09-24. Median across all
  // measured models is ~13, so AA<15 means "actively dumb", AA>35 is frontier.
  // Prices are OPENROUTER's, which often differ from the vendor first-party
  // prices AA quotes — openrouter is what actually gets billed.
  //
  // Budget ceiling: ~0.50 in / ~1.05 out USD per M tokens (deepseek-flash
  // reference 0.099/0.60 + ~0.40 tolerance). Everything live below fits.
  //
  // TRAPS — cheap, plausible-sounding, and measurably bad. Do NOT re-add:
  //   qwen/qwen3-coder-next            AA=9   "coder" in the name, near-worst
  //   qwen/qwen3-coder-30b-a3b         AA=10
  //   arcee-ai/trinity-large-thinking  AA=11  "thinking" in the name, weak
  //   z-ai/glm-4.6v                    AA=8   was our top VLM pick — it is not
  //   meta-llama/llama-4-scout         AA=8   big ctx, empty head
  //   qwen/qwen3-vl-30b / -32b / -8b   AA=8/8/7
  //   openai/gpt-oss-120b              AA=12  + 21% malformed edits on Aider
  //
  // Resolved surprises worth remembering:
  //   openai/gpt-6-luna    AA=37 at 0.10/0.50 — one of the best value models in
  //     existence, NOT weak. Suspicion that it trails deepseek-flash: refuted.
  //   xiaomi/mimo-v2.6-pro AA=46 at 0.43/0.87 — #1 open-weight model on AA and
  //     still inside budget. Ties grok-4.7 (AA=46) at ~1/5 the price.
  //   z-ai/glm-5.3-flash   AA=42 at 0.15/0.50 — best raw value in the list.
  //   deepseek pro family: you granted an exception for it, but it is NOT worth
  //     using. deepseek-v4-pro scores AA=36 at 0.94/1.89 — LOWER than
  //     glm-5.3-flash (AA=42) at ~6x the price. Exception deliberately unused;
  //     the pro entries are parked in the commented blocks instead.
  //
  // Family gotcha (src/models/resolveFamily.ts matches substrings):
  //   deepseek|qwen|minimax|yi|zhipu -> openrouter-generic, glm -> glm,
  //   gpt -> gpt, everything else -> fallback. generic+fallback use 0.3/0.9.
  //   gpt-6-luna therefore gets reasoningEffort injected — that is CORRECT
  //   here, it is a reasoning model with a low/medium/high/xhigh effort ladder.
  //
  // Dedup gotcha (src/fallback/canonicalize.ts): entries equivalent to the
  // current model are skipped, so never list two spellings of one model.

  // Global default model for agents that do not set their own `model`
  // (also drives family reasoning options like claude extended thinking).
  "model": "anthropic/claude-sonnet-5",

  // ── Agents (all 11 shipped personas) ────────────────────────────────────
  // Per-agent `model` / `fallback_models` / `color`.
  // `fallback_models` fully replaces the global fallback chain for that agent
  // (no merge). Color overrides the oh-my palette default (DEFAULT_COLORS in
  // src/agents/personas.ts).
  "agents": {
    // Primary orchestrator — long context, heavy delegation + verification
    // discipline. Best model available, then strictly AA-descending.
    "Sisyphus - ultraworker": {
      "model": "anthropic/claude-opus-5-5",
      "fallback_models": [
        "anthropic/claude-sonnet-5", //                    still on the Pro plan
        "anthropic/claude-haiku-4-5-20251001", //          last free tier
        "openrouter/xiaomi/mimo-v2.6-pro", //              AA=46  0.43/0.87  1.0M  best in budget, slow (51 t/s)
        "openrouter/z-ai/glm-5.3-flash", //                AA=42  0.15/0.50  1.3M  best value overall
        "openrouter/qwen/qwen3.8-flash", //                AA=40  0.15/0.47  1.0M
        "openrouter/deepseek/deepseek-v4.1-flash", //      AA=39  0.15/0.60  1.0M
        "openrouter/openai/gpt-6-luna", //                 AA=37  0.10/0.50  1.0M  cheapest frontier-ish
        "openrouter/deepseek/deepseek-v4-flash", //        AA=34  0.06/0.13  1.0M  absurd value floor
        "openrouter/upstage/solar-pro4", //                AA=28  0.09/0.36  524k
        "openrouter/inclusionai/ling-3.0-flash" //         AA=25  0.02/0.06  262k  last resort, near-free
        // ── premium: best orchestration money can buy ─────────────────────
        // "openrouter/x-ai/grok-4.7",                  // AA=46  1.60/4.80  500k  ties mimo at 4x price
        // "openrouter/z-ai/glm-5.3-prime",             // AA=45  2.80/8.80  1.0M
        // "openrouter/moonshotai/kimi-k3",             // AA=44  3.00/15.00 1.0M
        // "openrouter/anthropic/claude-opus-5.5",      //        4.00/20.00 1.0M  same brain as the base
        // "openrouter/openai/gpt-5.5",                 //        5.00/30.00 1.0M
        // "openrouter/deepseek/deepseek-v4-pro",       // AA=36  0.94/1.89  1.0M  worse than glm-5.3-flash
      ],
      "color": "#00CED1"
    },
    // Cheap focused executor for 1-2 file edits. NOTE: every model with
    // "coder" in its name benchmarked WORSE than these generalists.
    "Sisyphus-Junior": {
      "model": "anthropic/claude-sonnet-5",
