  // ── Runtime model fallback ──────────────────────────────────────────────
  // On a retryable session.error (rate limit, quota, 5xx, overloaded) the
  // plugin resubmits the same session on the next chain model.
  //
  // Semantics: chain advances attempt-by-attempt (rotation via attempt count);
  // non-terminal errors get ONE same-model retry first; terminal quota errors
  // rotate immediately. Attempt counter is per-session and cumulative until
  // plugin restart — `max_attempts` is the hard cap across the whole session.
  // Cooldown doubles per consecutive failure (60 → 120 → 240 … cap 32x).
  //
  // max_attempts must be >= fallback chain length, otherwise the tail of a
  // long chain never gets tried.
  "fallback": {
    "enabled": true,
    // HTTP codes treated as retryable (plus quota/billing wording is matched
    // by classify.ts regardless of this list).
    "retry_on_errors": [429, 500, 502, 503, 504],
    // Hard cap on fallback attempts per session. Longest per-agent chain is 10
    // entries — 20 leaves headroom for the same-model retry on non-terminal
    // errors plus room to extend a chain later.
    "max_attempts": 20,
    "cooldown_seconds": 60,
    // Global fallback chain: used by every agent (including delegated
    // subagents) that has no per-agent fallback_models entry. Per-agent lists
    // (top-level `agents` above) are the ONLY way to configure a specific
    // agent's chain and fully replace this global chain for that agent.
    // Pure AA-descending ladder, all in budget.
    "models": [
      "anthropic/claude-sonnet-5", //                      still on the Pro plan
      "anthropic/claude-haiku-4-5-20251001", //            last free tier
      "openrouter/xiaomi/mimo-v2.6-pro", //                AA=46  0.43/0.87  1.0M
      "openrouter/z-ai/glm-5.3-flash", //                  AA=42  0.15/0.50  1.3M
      "openrouter/qwen/qwen3.8-flash", //                  AA=40  0.15/0.47  1.0M
      "openrouter/deepseek/deepseek-v4.1-flash", //        AA=39  0.15/0.60  1.0M
      "openrouter/openai/gpt-6-luna", //                   AA=37  0.10/0.50  1.0M
      "openrouter/deepseek/deepseek-v4-flash", //          AA=34  0.06/0.13  1.0M
      "openrouter/inclusionai/ling-3.0-flash" //           AA=25  0.02/0.06  262k
    ]
  },

  // ── Per-family sampling ─────────────────────────────────────────────────
  // All 7 families from src/models/resolveFamily.ts made explicit:
  //   kimi / glm / openrouter-generic / fallback → cheap 0.3/0.9 (matches
  //     DEFAULT_SAMPLING + guards family)
  //   claude / gpt / gemini → 0.4/0.8 (README example values)
  // Missing families would fall back to provider defaults; listed here so
  // every family is intentionally pinned.
  // Note: xiaomi/*, upstage/*, tencent/*, inclusionai/*, x-ai/* all resolve to
  // the `fallback` family (no substring match), so that entry is load-bearing.
  "sampling": {
    "claude": { "temperature": 0.4, "topP": 0.8 },
    "gpt": { "temperature": 0.4, "topP": 0.8 },
    "gemini": { "temperature": 0.4, "topP": 0.8 },
    "kimi": { "temperature": 0.3, "topP": 0.9 },
    "glm": { "temperature": 0.3, "topP": 0.9 },
    "openrouter-generic": { "temperature": 0.3, "topP": 0.9 },
    "fallback": { "temperature": 0.3, "topP": 0.9 }
  },

  // ── Skills ──────────────────────────────────────────────────────────────
  // Extra skill directories to bridge into opencode's native skills dir
  // (~/.config/opencode/skills). oh-my kept its own cache at
  // ~/.cache/opencode/skills — list it here to make those skills usable again.
  // Each `<name>/SKILL.md` subdir is symlinked in (never overwrites existing).
  "skills": {
    "extraDirs": ["/home/astroreen/.cache/opencode/skills"]
  },

  // ── Idle continuation ───────────────────────────────────────────────────
  // Opt-in: when a session goes idle with unfinished todos, continue it
  // automatically (capped per session). Off by default to avoid loops —
  // flip `enabled` to true to arm it; `max` caps sends per session, cooldown
  // and failure caps are hardcoded (src/idle/constants.ts).
  "idleContinuation": { "enabled": false, "max": 3 },

  // ── Reasoning injection ─────────────────────────────────────────────────
  // Inject family reasoning options: claude extended thinking (32000 budget),
  // gpt reasoningEffort "medium" (or :level suffix ladder). Set false to
  // disable entirely.
  "reasoning": { "enabled": true }
}
